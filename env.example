# SeaTalk credentials and account policy do not require user-visible .env variables.
#
# Configure SeaTalk accounts under ~/.hermes/config.yaml instead. The account
# app_secret and signing_secret values live in config.yaml, so protect that file
# as secret-bearing configuration.
#
# Home channel follows Hermes' standard env contract. Use /sethome from SeaTalk
# or set these optional values in ~/.hermes/.env:
#
# SEATALK_HOME_CHANNEL=default:group/raw_seatalk_group_id
# SEATALK_HOME_CHANNEL_THREAD_ID=
#
# platforms:
#   seatalk:
#     enabled: true
#     extra:
#       accounts:
#         default:
#           enabled: true
#           app_id: your_app_id
#           app_secret: your_app_secret
#           # signing_secret is required for webhook (HMAC) and relay; the native
#           # websocket mode authenticates with app_id/app_secret only and can omit it.
#           signing_secret: your_signing_secret
#           # mode: webhook | relay | websocket
#           #   webhook   - SeaTalk HTTP POSTs to a public callback endpoint
#           #   relay     - outbound WebSocket to a self-hosted seatalk-relay
#           #   websocket - outbound WebSocket directly to SeaTalk (native Event
#           #               Callback via the official SDK; no public endpoint and
#           #               no relay). Switch the bot's Event Callback method to
#           #               WebSocket in the Developer Portal and click Re-verify
#           #               while the gateway is connected. A bot can use only one
#           #               delivery method at a time.
#           mode: websocket
#           # ws_url defaults to wss://ws-openapi.haiserve.com/ws/bot when omitted
#           ws_url: wss://ws-openapi.haiserve.com/ws/bot
#           # webhook mode only:
#           # webhook_host: 0.0.0.0
#           # webhook_port: 8080
#           # webhook_path: /callback
#           # relay mode only:
#           # relay_url: wss://your-relay.example.com/ws
#           # Outbound text format: 2 = Markdown/rich text (default), 1 = plain text
#           text_format: 2
#           dm_policy: allowlist
#           allow_from:
#             - alice@example.com
#           group_policy: open
#           group_allow_from:
#             - raw_seatalk_group_id
#           group_sender_allow_from:
#             - alice@example.com
#           processing_indicator: typing
